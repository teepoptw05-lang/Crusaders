let current = 0;
let ember = 0;
let faith = 10;
let history = [];
let answered = false;

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function startQuest(){
  current = 0; ember = 0; faith = 10; history = [];
  showScreen('screen-quest');
  renderChapter();
}

function updateMeters(){
  document.getElementById('emberVal').textContent = ember;
  document.getElementById('emberFill').style.width = (ember / CHAPTERS.length * 100) + '%';
  document.getElementById('faithVal').textContent = faith + '/10';
  document.getElementById('faithFill').style.width = (faith * 10) + '%';
}

function renderChapter(){
  answered = false;
  const ch = CHAPTERS[current];
  document.getElementById('chapterTag').textContent = `บทที่ ${current + 1} จาก ${CHAPTERS.length}`;
  document.getElementById('sceneText').innerHTML = ch.scene + `<span class="voice">${ch.voice}</span>`;
  updateMeters();

  const wrap = document.getElementById('choices');
  wrap.innerHTML = '';
  const sigils = ['✦','✧','✥','✣'];
  ch.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'choice';
    btn.innerHTML = `<span class="sigil">${sigils[i]}</span><span>${opt}</span>`;
    btn.onclick = () => choose(i);
    wrap.appendChild(btn);
  });

  const oracle = document.getElementById('oracle');
  oracle.classList.remove('show');
  oracle.innerHTML = '';
  document.getElementById('btnNext').classList.remove('show');
}

function choose(i){
  if(answered) return;
  answered = true;
  const ch = CHAPTERS[current];
  const btns = document.querySelectorAll('#choices .choice');
  btns.forEach(b => b.disabled = true);

  const isRight = (i === ch.correct);
  if(isRight){ ember++; } else { faith = Math.max(0, faith - 1); }
  btns[ch.correct].classList.add('correct');
  if(!isRight) btns[i].classList.add('wrong');

  history.push({ isRight, outcome: ch.outcome });
  updateMeters();

  const oracle = document.getElementById('oracle');
  oracle.innerHTML = `<span class="who">${isRight ? '✦ ไม้กางเขนเพลิงเปล่งแสง' : '✦ เงาแห่งความสงสัยปกคลุม'}</span>${ch.outcome}`;
  oracle.classList.add('show');

  const btnNext = document.getElementById('btnNext');
  btnNext.classList.add('show');
  btnNext.textContent = (current === CHAPTERS.length - 1) ? 'มองเห็นตำนานของเจ้า ✦' : 'ก้าวต่อไป ✦';
}

function nextChapter(){
  current++;
  if(current >= CHAPTERS.length){ showResult(); }
  else { renderChapter(); }
}

function showResult(){
  showScreen('screen-result');

  let title, desc;
  if(ember <= 3){
    title = 'ผู้แสวงหาที่หลงทาง';
    desc = 'ม่านหมอกแห่งกาลเวลาพัดพาเจ้ากลับมา แต่หลายบทของตำนานยังพร่าเลือนในความทรงจำ บางทีการเดินทางอีกครั้งอาจทำให้ทุกอย่างชัดเจนขึ้น';
  } else if(ember <= 6){
    title = 'อัศวินหัดใหม่แห่งไม้กางเขน';
    desc = 'เจ้าผ่านพ้นมาได้หลายบท แม้บางครั้งจะพลาดพลั้ง แต่ไฟแห่งตำนานในตัวเจ้ายังคงลุกโชนไม่ดับ';
  } else if(ember <= 8){
    title = 'อัศวินเทมพลาร์ผู้ยิ่งใหญ่';
    desc = 'ไม้กางเขนเพลิงในมือเจ้าเรืองแสงสว่างไสว เจ้าจดจำทุกเหตุการณ์สำคัญได้อย่างแม่นยำ เหลือเพียงก้าวเดียวสู่ความสมบูรณ์';
  } else {
    title = 'ผู้พิทักษ์แห่งกาลเวลา ตำนานนิรันดร์';
    desc = 'ไม่มีบทใดในตำนานนี้ที่หลุดลอดสายตาเจ้าไปได้ ดวงวิญญาณของเจ้าได้เดินทางผ่านทุกยุคสมัยแห่งสงครามศักดิ์สิทธิ์ และกลับมาพร้อมปัญญาอันสมบูรณ์';
  }

  document.getElementById('titleName').textContent = title;
  document.getElementById('resultDesc').textContent = desc;

  const relicsRow = document.getElementById('relicsRow');
  relicsRow.innerHTML = '';
  history.forEach(h => {
    const r = document.createElement('div');
    r.className = 'relic' + (h.isRight ? ' won' : '');
    r.textContent = h.isRight ? '✦' : '✧';
    relicsRow.appendChild(r);
  });

  const list = document.getElementById('chronicleList');
  list.innerHTML = '';
  history.forEach((h, i) => {
    const row = document.createElement('div');
    row.className = 'chron-item';
    row.innerHTML = `<span class="chron-mark ${h.isRight ? 'ok' : 'no'}">${h.isRight ? '✦' : '✧'}</span><span>บทที่ ${i+1}: ${h.outcome}</span>`;
    list.appendChild(row);
  });
}

function restartQuest(){
  showScreen('screen-start');
}
</script>
