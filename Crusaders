<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ผู้พิทักษ์แห่งกาลเวลา: ตำนานไม้กางเขนเพลิง</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=MedievalSharp&family=IM+Fell+English:ital@0;1&family=Cinzel:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --void: #0D0B08;
    --void-2: #16120C;
    --panel: #1D1712;
    --panel-edge: #3A2C1A;
    --parchment: #E9DCB8;
    --gold: #C9962E;
    --gold-bright: #F0C767;
    --ember: #B8451F;
    --ember-bright: #E36B2E;
    --azure: #3E6E8E;
    --spirit: #8FBFC2;
    --good: #5A8C4E;
    --bad: #A3352A;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    min-height:100vh;
    background:
      radial-gradient(ellipse 900px 500px at 50% -10%, rgba(201,150,46,0.12), transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 100%, rgba(184,69,31,0.10), transparent 55%),
      linear-gradient(180deg, var(--void) 0%, var(--void-2) 100%);
    color: var(--parchment);
    font-family:'IM Fell English', serif;
    display:flex;
    justify-content:center;
    padding: 26px 14px 60px;
  }
  .stage{
    width:100%;
    max-width:660px;
  }

  /* flame divider */
  .flamebar{
    display:flex; align-items:center; gap:10px;
    justify-content:center;
    color: var(--gold);
    font-size:13px;
    letter-spacing:4px;
    margin-bottom:16px;
  }
  .flamebar .line{ flex:1; height:1px; background:linear-gradient(90deg, transparent, var(--panel-edge), transparent); }

  header.top{ text-align:center; margin-bottom:24px; }
  .rune{ font-size:34px; margin-bottom:8px; filter: drop-shadow(0 0 10px rgba(240,199,103,0.5)); }
  h1{
    font-family:'MedievalSharp', cursive;
    font-size:clamp(26px, 6.4vw, 36px);
    margin:0 0 8px;
    color: var(--gold-bright);
    text-shadow: 0 0 18px rgba(240,199,103,0.35), 0 2px 0 #000;
    letter-spacing:1px;
  }
  .subtitle{
    font-style:italic;
    color:#B9A87F;
    font-size:16px;
    margin:0;
  }

  .panel{
    background: linear-gradient(180deg, rgba(29,23,18,0.9), rgba(20,16,11,0.95));
    border: 1px solid var(--panel-edge);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 10px 30px rgba(0,0,0,0.5), inset 0 0 40px rgba(201,150,46,0.03);
    border-radius: 4px;
    padding: 26px 24px;
    position:relative;
  }
  .panel::before, .panel::after{
    content:"✦";
    position:absolute;
    color: var(--panel-edge);
    font-size:14px;
  }
  .panel::before{ top:8px; left:10px; }
  .panel::after{ bottom:8px; right:10px; }

  .screen{ display:none; }
  .screen.active{ display:block; }

  /* meters */
  .meters{
    display:flex;
    gap:16px;
    margin-bottom:18px;
    flex-wrap:wrap;
  }
  .meter{ flex:1; min-width:140px; }
  .meter-label{
    font-family:'Cinzel', serif;
    font-size:11px;
    letter-spacing:2px;
    color: var(--gold);
    margin-bottom:5px;
    display:flex; justify-content:space-between;
  }
  .meter-track{
    height:9px;
    background:#0E0B07;
    border:1px solid var(--panel-edge);
    border-radius:2px;
    overflow:hidden;
  }
  .meter-fill{
    height:100%;
    background: linear-gradient(90deg, var(--ember), var(--gold-bright));
    transition: width .5s ease;
  }
  .meter-fill.faith{ background: linear-gradient(90deg, var(--azure), var(--spirit)); }

  .chapter-tag{
    font-family:'Cinzel', serif;
    font-size:12px;
    letter-spacing:3px;
    color:#9C8455;
    text-align:center;
    margin-bottom:14px;
  }

  /* start */
  .lede{
    font-size:19px;
    line-height:1.85;
    color:#DCCBA0;
    margin-bottom:18px;
  }
  .lede b{ color: var(--gold-bright); font-weight:normal; }
  .lede em{ color: var(--spirit); font-style:italic; }

  button{ font-family:'Cinzel', serif; cursor:pointer; border:none; }

  .btn-glow{
    display:block;
    width:100%;
    background: linear-gradient(180deg, #3A2410, #241608);
    color: var(--gold-bright);
    font-size:17px;
    font-weight:600;
    letter-spacing:2px;
    padding:16px 20px;
    border: 1px solid var(--gold);
    box-shadow: 0 0 18px rgba(201,150,46,0.18), inset 0 0 12px rgba(240,199,103,0.08);
    transition: box-shadow .15s ease, transform .08s ease;
  }
  .btn-glow:hover{ box-shadow: 0 0 26px rgba(240,199,103,0.35), inset 0 0 12px rgba(240,199,103,0.15); }
  .btn-glow:active{ transform: translateY(2px); }

  /* narrative */
  .scene-text{
    font-size:19px;
    line-height:1.85;
    color:#DCCBA0;
    margin-bottom:18px;
  }
  .scene-text .voice{
    display:block;
    margin-top:12px;
    padding:12px 16px;
    border-left:3px solid var(--gold);
    background: rgba(201,150,46,0.06);
    color: var(--gold-bright);
    font-style:italic;
    font-size:17px;
  }

  .choices{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-bottom:16px;
  }
  .choice{
    text-align:left;
    background: rgba(233,220,184,0.03);
    border:1px solid var(--panel-edge);
    color: var(--parchment);
    font-family:'IM Fell English', serif;
    font-size:17px;
    padding:13px 16px;
    display:flex;
    gap:12px;
    line-height:1.5;
  }
  .choice .sigil{
    font-family:'MedievalSharp', cursive;
    color: var(--gold);
    flex-shrink:0;
  }
  .choice:hover:not(:disabled){
    background: rgba(201,150,46,0.10);
    border-color: var(--gold);
  }
  .choice:disabled{ cursor:default; }
  .choice.correct{
    background: rgba(90,140,78,0.16);
    border-color: var(--good);
  }
  .choice.correct .sigil{ color: var(--good); }
  .choice.wrong{
    background: rgba(163,53,42,0.14);
    border-color: var(--bad);
  }
  .choice.wrong .sigil{ color: var(--bad); }

  .oracle{
    display:none;
    font-size:16px;
    line-height:1.75;
    padding:14px 16px;
    border-left:3px solid var(--azure);
    background: rgba(62,110,142,0.08);
    color:#C7D6DA;
    margin-bottom:16px;
  }
  .oracle.show{ display:block; }
  .oracle .who{
    font-family:'Cinzel', serif;
    font-size:12px;
    letter-spacing:2px;
    color: var(--spirit);
    display:block;
    margin-bottom:6px;
  }

  .next-wrap{ display:flex; justify-content:flex-end; }
  .btn-next{
    background: transparent;
    color: var(--gold-bright);
    border:1px solid var(--gold);
    font-size:14px;
    letter-spacing:2px;
    padding:11px 22px;
    display:none;
  }
  .btn-next.show{ display:inline-block; }
  .btn-next:hover{ background: rgba(201,150,46,0.12); }

  /* result */
  .result-eyebrow{
    text-align:center;
    font-family:'Cinzel', serif;
    font-size:13px;
    letter-spacing:3px;
    color:#9C8455;
    margin-bottom:8px;
  }
  .title-name{
    text-align:center;
    font-family:'MedievalSharp', cursive;
    font-size:clamp(24px,6.5vw,32px);
    color: var(--gold-bright);
    text-shadow: 0 0 20px rgba(240,199,103,0.35);
    margin:0 0 18px;
  }
  .relics-row{
    display:flex;
    justify-content:center;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:18px;
  }
  .relic{
    width:34px; height:34px;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--panel-edge);
    border-radius:50%;
    background: rgba(201,150,46,0.05);
  }
  .relic.won{ border-color: var(--gold); box-shadow: 0 0 10px rgba(240,199,103,0.4); background: rgba(201,150,46,0.12); }
  .result-desc{
    font-size:18px;
    line-height:1.85;
    color:#DCCBA0;
    text-align:center;
    margin-bottom:22px;
  }

  .chronicle{
    border-top:1px solid var(--panel-edge);
    padding-top:14px;
    margin-bottom:22px;
  }
  .chronicle-title{
    font-family:'Cinzel', serif;
    font-size:12px;
    letter-spacing:2px;
    color:#9C8455;
    margin-bottom:10px;
    text-align:center;
  }
  .chron-item{
    font-size:15px;
    line-height:1.6;
    padding:7px 0;
    border-bottom:1px dotted rgba(154,132,85,0.25);
    display:flex;
    gap:8px;
    color:#C7B78C;
  }
  .chron-item:last-child{ border-bottom:none; }
  .chron-mark{ flex-shrink:0; font-weight:700; }
  .chron-mark.ok{ color: var(--good); }
  .chron-mark.no{ color: var(--bad); }

  footer.seal{
    text-align:center;
    margin-top:22px;
    font-size:12px;
    color:#6E5D3B;
    letter-spacing:2px;
  }

  @media (max-width: 420px){
    .panel{ padding:20px 16px; }
    .scene-text, .lede{ font-size:17px; }
  }
</style>
</head>
<body>
<div class="stage">

  <header class="top">
    <div class="rune">✦</div>
    <h1>ผู้พิทักษ์แห่งกาลเวลา</h1>
    <p class="subtitle">ตำนานไม้กางเขนเพลิง — บทเพลงแห่งสงครามครูเสด</p>
  </header>

  <div class="panel">

    <!-- START -->
    <section class="screen active" id="screen-start">
      <div class="lede">
        เจ้าตื่นขึ้นกลางความมืด แสงจากอัญมณีสีเพลิงบนมือของเจ้าเต้นระริก มันคือ <b>เศษเสี้ยวแห่งไม้กางเขนศักดิ์สิทธิ์</b>
        ที่ดึงดวงวิญญาณของเจ้าข้ามผ่านศตวรรษ สู่ยุคแห่งดาบ ไฟ และศรัทธา
      </div>
      <div class="lede">
        มีเสียงกระซิบดังขึ้นรอบกาย — <em>"ผู้พิทักษ์แห่งกาลเวลา... เจ้าจะได้เห็นทุกบทของสงครามศักดิ์สิทธิ์ ตั้งแต่เสียงเรียกร้องแรก
        จนถึงเถ้าถ่านสุดท้ายที่เมืองอากร์ ทุกย่างก้าวจะทดสอบเจ้า จงเลือกให้ดี เพราะสิ่งที่เจ้าเลือกจะสลักไว้ในตำนาน"</em>
      </div>
      <div class="lede">เจ้าพร้อมจะก้าวข้ามม่านหมอกแห่งกาลเวลาแล้วหรือยัง?</div>
      <button class="btn-glow" onclick="startQuest()">✦ ก้าวข้ามม่านหมอก</button>
    </section>

    <!-- QUEST -->
    <section class="screen" id="screen-quest">
      <div class="chapter-tag" id="chapterTag">บทที่ 1</div>

      <div class="meters">
        <div class="meter">
          <div class="meter-label"><span>ไฟแห่งตำนาน</span><span id="emberVal">0</span></div>
          <div class="meter-track"><div class="meter-fill" id="emberFill" style="width:0%"></div></div>
        </div>
        <div class="meter">
          <div class="meter-label"><span>สายตาผู้พิทักษ์</span><span id="faithVal">10/10</span></div>
          <div class="meter-track"><div class="meter-fill faith" id="faithFill" style="width:100%"></div></div>
        </div>
      </div>

      <div class="scene-text" id="sceneText"></div>

      <div class="choices" id="choices"></div>
      <div class="oracle" id="oracle"></div>

      <div class="next-wrap">
        <button class="btn-next" id="btnNext" onclick="nextChapter()">ก้าวต่อไป ✦</button>
      </div>
    </section>

    <!-- RESULT -->
    <section class="screen" id="screen-result">
      <div class="result-eyebrow">ตำนานของเจ้าถูกจารึกแล้ว</div>
      <div class="title-name" id="titleName"></div>
      <div class="relics-row" id="relicsRow"></div>
      <div class="result-desc" id="resultDesc"></div>

      <div class="chronicle">
        <div class="chronicle-title">✦ บันทึกแห่งการเดินทาง ✦</div>
        <div id="chronicleList"></div>
      </div>

      <button class="btn-glow" onclick="restartQuest()">✦ ข้ามม่านหมอกอีกครั้ง</button>
    </section>

  </div>

  <footer class="seal">✦ 1095 — 1291 ✦ ไม้กางเขนเพลิงจะไม่มีวันดับ ✦</footer>
</div>

<script>
const CHAPTERS = [
  {
    scene: `เจ้าปรากฏตัวกลางลานหินแห่งแคลร์มงต์ ฝรั่งเศส ฝูงชนนับพันคุกเข่าท่ามกลางเสียงตะโกน "Deus vult! พระเจ้าทรงประสงค์เช่นนั้น!"
      ชายชราในอาภรณ์สีขาวยืนบนแท่นสูง เปล่งวาจาที่จะจุดไฟสงครามไปทั่วทวีป`,
    voice: `เสียงกระซิบดังในหัวเจ้า — "จงมองให้ลึกกว่าคำปราศรัย... อะไรคือประกายไฟที่แท้จริงที่ทำให้ชายผู้นี้เอ่ยคำเรียกร้องนี้?"`,
    options: [
      "จักรพรรดิแห่งคอนสแตนติโนเปิลส่งสาสน์ขอกำลังเสริมต้านทัพเติร์กเซลจุคที่รุกคืบ",
      "กรุงโรมถูกกองทัพต่างศาสนาล้อมไว้",
      "กษัตริย์แห่งแฟรงก์ถูกโค่นบัลลังก์",
      "ทวีปทั้งหมดกำลังจะจมดิ่งสู่ทุพภิกขภัย"
    ],
    correct: 0,
    outcome: "เศษเสี้ยวไม้กางเขนในมือเจ้าเรืองแสงวาบ — จักรพรรดิอเล็กซิออสที่ 1 แห่งไบแซนไทน์ได้ส่งเสียงร้องขอความช่วยเหลือจริง เมื่อดินแดนเอเชียไมเนอร์ถูกเติร์กเซลจุครุกราน สมเด็จพระสันตะปาปาเออร์บันที่ 2 จึงฉวยโอกาสจุดไฟแห่งสงครามครูเสดครั้งแรกขึ้น"
  },
  {
    scene: `หลายฤดูกาลผ่านไป เจ้ายืนอยู่หน้ากำแพงหินสูงตระหง่านของนครศักดิ์สิทธิ์ ควันไฟลอยคละคลุ้ง เสียงร้องประสานกับเสียงเหล็กกระทบเหล็ก
      กองทัพผู้แสวงบุญสวมเกราะปีนบันไดขึ้นสู่กำแพง ธงไม้กางเขนโบกสะบัดเหนือควันดำ`,
    voice: `"นี่คือช่วงเวลาที่โลกจะเปลี่ยนไปตลอดกาล... เจ้ารู้หรือไม่ว่าคืนนี้จะจบลงอย่างไร?"`,
    options: [
      "กองทัพครูเสดยึดนครเยรูซาเล็มได้สำเร็จ และสถาปนาอาณาจักรแห่งใหม่บนแผ่นดินนี้",
      "กองทัพครูเสดพ่ายแพ้และล่าถอยกลับสู่ยุโรปทั้งหมด",
      "ทั้งสองฝ่ายลงนามสงบศึกก่อนการปะทะจะเริ่มขึ้น",
      "นครแห่งนี้ถูกทิ้งร้างไปโดยไม่มีใครยึดครอง"
    ],
    correct: 0,
    outcome: "ในปี ค.ศ. 1099 กำแพงนั้นแตก กองทัพครูเสดบุกเข้ายึดเยรูซาเล็มได้สำเร็จ พร้อมการสังหารหมู่ครั้งใหญ่ จากนั้นจึงสถาปนา 'ราชอาณาจักรเยรูซาเล็ม' ขึ้นเป็นหมุดหมายแรกแห่งชัยชนะของฝ่ายครูเสด"
  },
  {
    scene: `เก้าสิบปีผ่านไปในพริบตา เจ้ายืนอยู่กลางทะเลทรายที่แผดเผา เบื้องหน้าคือเต็นท์ไหมสีเขียวมรกตของขุนศึกผู้หนึ่ง
      เขามีสายตาสงบนิ่งราวกับสายลม แต่กองทัพเบื้องหลังเขากลับเกรียงไกรราวพายุทราย เขาเพิ่งพลิกชะตาของนครศักดิ์สิทธิ์อีกครั้ง`,
    voice: `"จงจำใบหน้านี้ไว้ให้ดี... ชื่อของเขาจะถูกเล่าขานทั้งในหมู่มิตรและศัตรู เขาคือใครกันแน่?"`,
    options: [
      "ซาลาดิน (ศอลาฮุดดีน) แห่งราชวงศ์อัยยูบิด",
      "สุลต่านบาอิบาร์สแห่งมัมลูก",
      "นักรบเร่ร่อนนามว่านูร์ อัด-ดิน",
      "แม่ทัพไร้นามแห่งเปอร์เซีย"
    ],
    correct: 0,
    outcome: "ซาลาดินคือผู้นั้น หลังชัยชนะเด็ดขาดในยุทธการที่ฮัตติน เขายึดเยรูซาเล็มคืนได้ในปี ค.ศ. 1187 ข่าวการล่มสลายของนครศักดิ์สิทธิ์สั่นสะเทือนยุโรปทั้งทวีป และจุดชนวนสงครามครูเสดครั้งที่ 3 ขึ้นทันที"
  },
  {
    scene: `ริมชายฝั่งทะเลเมดิเตอร์เรเนียน เรือรบลำมหึมาโบกธงสิงห์แดงเข้าเทียบท่า ชายร่างใหญ่ในชุดเกราะเหล็กก้าวลงจากเรือ
      ดวงตาเขาเปล่งประกายแห่งนักรบผู้ไม่เคยรู้จักคำว่าถอย กองทัพทั้งยุโรปต่างกล่าวขวัญถึงเขา`,
    voice: `"อัศวินผู้นี้จะกลายเป็นคู่ปรับที่ซาลาดินเองยังต้องยกย่อง... เขาคือกษัตริย์แห่งใด?"`,
    options: [
      "พระเจ้าริชาร์ดใจสิงห์แห่งอังกฤษ",
      "พระเจ้าเฮนรีที่ 2 แห่งอังกฤษ",
      "พระเจ้าฟิลิปที่ 2 แห่งฝรั่งเศส",
      "จักรพรรดิเฟรเดอริก บาร์บารอสซา"
